# Seedle Web Configuration Example
# Copy to apps/web/.env.local and populate as needed.

# Auth0 Authentication (Optional: defaults to nomaze tenant if unset)
NEXT_PUBLIC_AUTH0_DOMAIN=auth.nomaze.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=seedle-web-spa-client
NEXT_PUBLIC_AUTH0_AUDIENCE=https://seedle.eu

# Public Application URL (Default: https://seedle.eu)
NEXT_PUBLIC_APP_URL=https://seedle.eu

# Optional Backend API URL (for hybrid/API proxy mode)
# NEXT_PUBLIC_SEEDLE_API_URL=http://127.0.0.1:8010/

# Reference date used as "today" by "Your field today" (season preview)
DEMO_HEUTE=2027-06-18

# Target season for variety recommendation calculations
PLANUNGSSAISON=2027

# Directory for local database and storage (relative to apps/web)
DATA_DIR=.data

# Debug session logging (1 = log new sessions to server output)
SK_DEBUG_SESSION=
