{
  "name": "@seedle/web",
  "version": "0.1.0",
  "private": true,
  "description": "Seedle web application and UI client (/api/v1)",
  "scripts": {
    "predev": "node scripts/vendor-maplibre.mjs",
    "dev": "cross-env CI=1 next dev",
    "prebuild": "node scripts/vendor-maplibre.mjs",
    "build": "cross-env CI=1 STATIC_EXPORT=1 next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.30.0",
    "@seedle/contracts": "*",
    "@seedle/core": "*",
    "@seedle/spross": "*",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.53.0",
    "maplibre-gl": "^6.13.0",
    "next": "16.4.5",
    "pmtiles": "^4.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
